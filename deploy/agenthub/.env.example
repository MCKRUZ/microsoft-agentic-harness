# Copy to deploy/agenthub/.env and fill in. Never commit the real .env file (already gitignored).
#
# Proven setup (M0 migration spike): OpenRouter as an OpenAI-compatible endpoint, with Anthropic
# prompt caching enabled. See documentation/onboarding/18-self-hosted-docker.html for the full
# walkthrough, including the direct-Anthropic alternative once issue #592 ships.

# https://openrouter.ai/keys
AGENT_FRAMEWORK_API_KEY=sk-or-v1-your-key-here

# OpenRouter's OpenAI-compatible base URL. Leave as-is unless pointing at a different
# OpenAI-compatible provider.
AGENT_FRAMEWORK_ENDPOINT=https://openrouter.ai/api/v1

# Any model OpenRouter serves, e.g. anthropic/claude-opus-4.8
AGENT_FRAMEWORK_DEFAULT_DEPLOYMENT=anthropic/claude-opus-4.8