<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Not a test project: it contains no tests and must not be handed to the runner.
         It is support code shared BY test projects. -->
    <IsTestProject>false</IsTestProject>
    <RootNamespace>Tests.Common</RootNamespace>
    <Configurations>Debug;Release;Debug-AgentHub-All;Debug-AgentHub-WebUI;Debug-AgentHub-Dashboard</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <!-- ISkillFileReader for UnsandboxedSkillFileReader (#645) — the only production interface this
         shared helper project depends on. Non-circular: Application.AI.Common never references
         Tests.Common. -->
    <ProjectReference Include="../../Application/Application.AI.Common/Application.AI.Common.csproj" />
  </ItemGroup>

</Project>
